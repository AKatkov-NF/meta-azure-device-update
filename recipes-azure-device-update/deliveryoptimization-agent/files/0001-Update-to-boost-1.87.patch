diff --git a/client-lite/src/exe/docs.cpp b/client-lite/src/exe/docs.cpp
index 53aa5cf..94ad16b 100644
--- a/client-lite/src/exe/docs.cpp
+++ b/client-lite/src/exe/docs.cpp
@@ -112,14 +112,16 @@ public:
         _workerThread.join();
     }
 
-    boost::asio::io_service& IoService()
